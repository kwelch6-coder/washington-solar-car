# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Added for deployment ───────────────────────────────────────────────────
# Source photography: build input only, never served. ~750MB of 10-29MB
# originals. The optimized derivatives the site actually serves live in
# public/images/ and ARE committed. Regenerate them from these originals with
# `node scripts/optimize-photos.mjs` — the source stays local by design.
/edited_photos

# Design reference material gathered while building. Not part of the build.
/reference

# Machine-local Claude Code permission grants.
.claude/settings.local.json
